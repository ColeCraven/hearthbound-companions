{
	"schemaVersion": 1,
	"id": "hearthbound",
	"version": "${version}",
	"name": "Hearthbound Companions",
	"description": "RPG-style companions: recruit them, talk to them, and adventure together. Single-player, or on a server with no client mod needed. Optional local or cloud AI dialogue.",
	"authors": ["Tekless"],
	"contact": {
		"homepage": "https://github.com/ColeCraven/hearthbound-companions",
		"sources": "https://github.com/ColeCraven/hearthbound-companions",
		"issues": "https://github.com/ColeCraven/hearthbound-companions/issues"
	},
	"license": "MIT",
	"icon": "assets/hearthbound/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": ["io.github.tekless.hearthbound.Hearthbound"],
		"client": ["io.github.tekless.hearthbound.client.HearthboundClient"]
	},
	"mixins": ["hearthbound.mixins.json"],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
